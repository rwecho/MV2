<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 供 flutter build ipa 的 export-options-plist 参数使用 -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>2VA9TC6SG4</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- 手动指定 profile：不依赖 Xcode 账号会话，CI 与本机行为一致。
	     这两个名字必须与开发者后台的 profile Name 一字不差。 -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>tech.zb.v2ex.maui.app</key>
		<string>tech.zb.v2ex.maui.app</string>
		<key>tech.zb.v2ex.maui.app.widget</key>
		<string>MV2 Widget App Store</string>
	</dict>
</dict>
</plist>
