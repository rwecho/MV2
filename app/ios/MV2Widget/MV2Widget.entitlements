<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget only *reads* the snapshot the app writes; no network, no
	     credentials. Keep in sync with Runner.entitlements and
	     ios/Runner/MV2NativeBridge.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.tech.zb.v2ex.maui.app</string>
	</array>
</dict>
</plist>
